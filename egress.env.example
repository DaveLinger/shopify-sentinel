# Tailscale egress sidecar configuration.
# Copy to egress.env and fill in — egress.env holds a secret, keep it out of any repo.

# Reusable auth key from https://login.tailscale.com/admin/settings/keys
# Use a *reusable* key so the node re-registers cleanly on rebuild.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Exit node to route Shopify traffic through.
#
#   dad-truenas-scale  100.115.249.118
#     Verified 2026-08-04: 24/24 stores OK. This is the fleet default.
#
#   home-truenas-scale 100.91.141.83
#     Also verified 24/24, but already in use by ytdl — avoid sharing it.
#
# Verify the resulting egress with:
#   docker run --rm --network shopify-egress \
#     -e EGRESS_PROXY=socks5h://shopify-egress:1055 \
#     shopify-catalog-test node egress-selftest.js
#
TS_EXTRA_ARGS=--exit-node=100.115.249.118
